<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="DevCore" android:textColor="#FFEA00" android:textSize="38sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Create Android apps on your phone" android:textColor="#9298A5" android:textSize="16sp" android:layout_marginBottom="28dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/newProject" android:layout_width="match_parent" android:layout_height="64dp"
            android:text="New Project" android:textSize="17sp" android:textColor="#000000" android:backgroundTint="#FFEA00" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/openProject" android:layout_width="match_parent" android:layout_height="64dp"
            android:layout_marginTop="12dp" android:text="Open Project" android:textSize="17sp" android:textColor="#FFFFFF" android:backgroundTint="#15171B" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Projects" android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:layout_marginTop="32dp" />
        <LinearLayout android:id="@+id/projectList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" />
    </LinearLayout>
</ScrollView>
